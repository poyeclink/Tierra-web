# Copy to .env.local and fill in. Never commit real values.

# Where the menu comes from: "local" (src/infrastructure/local/data) | "toast"
MENU_SOURCE=local

# Who receives online orders: "none" (ordering disabled) | "toast"
ORDER_PROVIDER=none

# Toast POS credentials (only required when MENU_SOURCE or ORDER_PROVIDER is "toast")
TOAST_API_HOSTNAME=
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=
